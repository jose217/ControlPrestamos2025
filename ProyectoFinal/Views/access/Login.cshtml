@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="limiter">
    <div class="container-login100">
        <div class="wrap-login100">
            <!-- Formas geométricas decorativas -->
            <div class="geometric-shapes">
                <span class="shape circle shape-1"></span>
                <span class="shape triangle shape-2"></span>
                <span class="shape square shape-3"></span>
                <span class="shape circle shape-4"></span>
                <span class="shape triangle shape-5"></span>
                <span class="shape circle shape-6"></span>
            </div>

            <!-- Imagen lateral -->
            <div class="login100-pic js-tilt" data-tilt>
                <img src="~/Content/images/img-01.png" alt="IMG">
            </div>

            <!-- Formulario de login -->
            <div class="login100-form">
                @using (Html.BeginForm("Login", "Access", FormMethod.Post, new { @class = "validate-form" }))
                {
                    @Html.AntiForgeryToken()

                    <span class="login100-form-title">
                        Sistema de Prestamo de Libros
                    </span>

                    if (ViewBag.Error != null)
                    {
                        <div style="background: #ffebee; color: #c62828; padding: 12px; border-radius: 8px; margin-bottom: 20px; text-align: center; font-size: 14px;">
                            @ViewBag.Error
                        </div>
                    }

                    <div class="wrap-input100 validate-input" data-validate="Valid email is required">
                        @Html.TextBox("Correo", null, new { @class = "input100", placeholder = "Email", type = "email" })
                        <span class="focus-input100"></span>
                        <span class="symbol-input100">
                            <i class="fa fa-envelope" aria-hidden="true"></i>
                        </span>
                    </div>

                    <div class="wrap-input100 validate-input" data-validate="Password is required">
                        @Html.Password("Contrasenia", null, new { @class = "input100", placeholder = "Password" })
                        <span class="focus-input100"></span>
                        <span class="symbol-input100">
                            <i class="fa fa-lock" aria-hidden="true"></i>
                        </span>
                    </div>

                    <div class="container-login100-form-btn">
                        <button type="submit" class="login100-form-btn">
                            Login
                        </button>
                    </div>

                    <div class="text-center p-t-12">
                        <span class="txt1">
                            Forgot
                        </span>
                        <a class="txt2" href="#">
                            Username / Password?
                        </a>
                    </div>

                    <div class="text-center p-t-136">
                        <a class="txt2" href="#">
                            Create your Account
                            <i class="fa fa-long-arrow-right m-l-5" aria-hidden="true"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>