@model IEnumerable<ProyectoFinal.Models.libros>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Libros</h2>

<div class="row mb-3">
    <div class="col-md-6">
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fa-solid fa-plus me-2"></i>Nuevo Libro
        </a>
    </div>
    <div class="col-md-6">
        @using (Html.BeginForm("Index", "libros", FormMethod.Get, new { @class = "form-inline float-end" }))
        {
            <div class="input-group">
                @Html.TextBox("searchString", ViewBag.CurrentFilter as string, new { @class = "form-control", placeholder = "Buscar por título o autor..." })
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="fa fa-search"></i> Buscar
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter as string))
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-danger">
                        <i class="fa fa-times"></i> Limpiar
                    </a>
                }
            </div>
        }
    </div>
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Imagen</th>
                <th>@Html.DisplayNameFor(model => model.titulo)</th>
                <th>@Html.DisplayNameFor(model => model.autor)</th>
                <th>@Html.DisplayNameFor(model => model.genero)</th>
                <th>@Html.DisplayNameFor(model => model.estado)</th>
                <th>@Html.DisplayNameFor(model => model.cantidad)</th>
                <th>@Html.DisplayNameFor(model => model.fechaPublicacion)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.imagen))
                        {
                            <img src="@Url.Content("~/Content/images/" + item.imagen)"
                                 alt="@item.titulo"
                                 style="width: 60px; height: 80px; object-fit: cover; border-radius: 4px;"
                                 onerror="this.src='@Url.Content("~/Content/images/default-book.jpg")'" />
                        }
                        else
                        {
                            <img src="@Url.Content("~/Content/images/default-book.jpg")"
                                 alt="Sin imagen"
                                 style="width: 60px; height: 80px; object-fit: cover; border-radius: 4px;" />
                        }
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.titulo)</td>
                    <td>@Html.DisplayFor(modelItem => item.autor)</td>
                    <td>@Html.DisplayFor(modelItem => item.genero)</td>
                    <td>@Html.DisplayFor(modelItem => item.estado)</td>
                    <td>@Html.DisplayFor(modelItem => item.cantidad)</td>
                    <td>@Html.DisplayFor(modelItem => item.fechaPublicacion)</td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning" title="Editar">
                            <i class="fa fa-pencil"></i>
                        </a>
                        <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info" title="Detalles">
                            <i class="fa fa-info-circle"></i>
                        </a>
                        <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger" title="Eliminar">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        <i class="fa fa-info-circle"></i> No se encontraron libros
        @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter as string))
        {
            <text> que coincidan con "<strong>@ViewBag.CurrentFilter</strong>"</text>
        }
    </div>
}